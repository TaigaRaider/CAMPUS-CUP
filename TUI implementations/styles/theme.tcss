/* ═══════════════════════════════════════════════════════════════════
   CAMPUS-CUP TUI Theme

   Color Palette:
     Background:  #000000 (black)
     Primary:     #0055ff (blue)   — headers, buttons, focused elements
     Secondary:   #00cc66 (green)  — success, active badges, stats
     Surface:     #111111           — cards, input fields, panels
     Text:        #ffffff           — primary text
     Muted:       #666666           — secondary text, borders
     Error:       #ff3333           — error states, danger actions
     Border:      #333333           — subtle dividers

   ═══════════════════════════════════════════════════════════════════ */

/* ── App-wide defaults ──────────────────────────────────────────── */

Screen {
    background: #000000;
    color: #ffffff;
}

Header {
    background: #0055ff;
    color: #ffffff;
}

Footer {
    background: #111111;
    color: #666666;
}

/* ── Sidebar ────────────────────────────────────────────────────── */

#sidebar {
    width: 28;
    background: #111111;
    border-right: solid #333333;
    padding: 1 0;
}

.sidebar-title {
    text-style: bold;
    color: #0055ff;
    text-align: center;
    padding: 1 0 0 0;
    margin: 0 0 1 0;
    height: 1;
}

.sidebar-user {
    color: #00cc66;
    text-align: center;
    padding: 0 0 1 0;
    margin: 0 0 1 0;
    height: 1;
}

.sidebar-role {
    color: #666666;
    text-align: center;
    text-style: italic;
    padding: 0 0 1 0;
    margin: 0 0 1 0;
    height: 1;
}

.sidebar-divider {
    height: 1;
    background: #333333;
    margin: 0 1;
}

#nav-buttons {
    height: 1fr;
}

#nav-buttons Button {
    width: 100%;
    background: #111111;
    color: #ffffff;
    border: none;
    text-align: left;
    padding: 0 1 0 2;
    height: 3;
    margin: 0 1;
}

#nav-buttons Button:hover {
    background: #0055ff;
    color: #ffffff;
}

#nav-buttons Button.-active {
    background: #0055ff;
    color: #ffffff;
    text-style: bold;
}

#logout-btn {
    width: 100%;
    background: #111111;
    color: #ff3333;
    border: none;
    text-align: left;
    padding: 0 1 0 2;
    height: 3;
    margin: 1 1 0 1;
}

#logout-btn:hover {
    background: #ff3333;
    color: #ffffff;
}

/* ── Main content area ──────────────────────────────────────────── */

#main-content {
    width: 1fr;
    background: #000000;
    padding: 1 2;
}

/* ── Screen layout (sidebar + content) ──────────────────────────── */

.screen-layout {
    height: 100%;
}

/* ── Login / Register screens ───────────────────────────────────── */

.auth-container {
    width: 60;
    height: 30;
    background: #111111;
    border: solid #333333;
    padding: 2 3;
    margin: 5 0;
}

.auth-title {
    text-style: bold;
    color: #0055ff;
    text-align: center;
    margin: 0 0 1 0;
    width: 100%;
}

.auth-subtitle {
    color: #666666;
    text-align: center;
    margin: 0 0 2 0;
    width: 100%;
}

.auth-container Input {
    background: #000000;
    border: solid #333333;
    color: #ffffff;
    margin: 0 0 1 0;
    width: 100%;
}

.auth-container Input:focus {
    border: solid #0055ff;
}

.auth-container Select {
    background: #000000;
    border: solid #333333;
    color: #ffffff;
    margin: 0 0 1 0;
    width: 100%;
}

.auth-container Select:focus {
    border: solid #0055ff;
}

.auth-container Button {
    width: 100%;
    margin: 1 0 0 0;
}

#login-btn {
    background: #0055ff;
    color: #ffffff;
}

#login-btn:hover {
    background: #0077ff;
}

#register-btn {
    background: #00cc66;
    color: #000000;
}

#register-btn:hover {
    background: #00ee88;
}

#goto-register {
    background: transparent;
    color: #0055ff;
    border: none;
    text-align: center;
    width: 100%;
    margin: 1 0 0 0;
}

#goto-register:hover {
    color: #0077ff;
}

#goto-login {
    background: transparent;
    color: #0055ff;
    border: none;
    text-align: center;
    width: 100%;
    margin: 1 0 0 0;
}

#goto-login:hover {
    color: #0077ff;
}

#auth-error {
    color: #ff3333;
    text-align: center;
    width: 100%;
    height: 1;
    margin: 0 0 0 0;
}

/* ── Dashboard ──────────────────────────────────────────────────── */

.dashboard-header {
    text-style: bold;
    color: #0055ff;
    margin: 0 0 1 0;
    width: 100%;
}

.stats-row {
    height: 7;
    margin: 0 0 1 0;
}

.stat-card {
    width: 1fr;
    background: #111111;
    border: solid #333333;
    padding: 1 1 0 1;
    margin: 0 1;
}

.stat-card .stat-value {
    text-style: bold;
    color: #00cc66;
    width: 100%;
    height: 2;
}

.stat-card .stat-label {
    color: #666666;
    width: 100%;
    height: 1;
}

.stat-card.primary .stat-value {
    color: #0055ff;
}

.section-header {
    text-style: bold;
    color: #ffffff;
    margin: 1 0 0 0;
    width: 100%;
}

/* ── DataTable ──────────────────────────────────────────────────── */

DataTable {
    background: #000000;
    color: #ffffff;
    border: solid #333333;
    width: 100%;
}

DataTable > .datatable--header {
    background: #111111;
    color: #0055ff;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #0055ff;
    color: #ffffff;
}

DataTable > .datatable--even-row {
    background: #000000;
}

DataTable > .datatable--odd-row {
    background: #0a0a0a;
}

DataTable:focus > .datatable--cursor {
    background: #0055ff;
    color: #ffffff;
}

/* ── Profile ────────────────────────────────────────────────────── */

.profile-card {
    width: 60;
    background: #111111;
    border: solid #333333;
    padding: 2;
    margin: 1 0;
}

.profile-name {
    text-style: bold;
    color: #0055ff;
    width: 100%;
}

.profile-id {
    color: #666666;
    width: 100%;
}

.profile-field {
    width: 100%;
    height: 1;
}

.profile-field-label {
    color: #666666;
}

.profile-field-value {
    color: #ffffff;
}

.badge {
    padding: 0 1;
    margin: 0 1 0 0;
}

.badge-admin {
    background: #0055ff;
    color: #ffffff;
}

.badge-player {
    background: #00cc66;
    color: #000000;
}

.badge-official {
    background: #666666;
    color: #ffffff;
}

/* ── Status badges ──────────────────────────────────────────────── */

.status-registering {
    background: #666666;
    color: #ffffff;
}

.status-registered {
    background: #0055ff;
    color: #ffffff;
}

.status-active {
    background: #00cc66;
    color: #000000;
}

.status-concluded {
    background: #333333;
    color: #666666;
}

.status-pending {
    background: #666666;
    color: #ffffff;
}

/* ── Discover tabs ──────────────────────────────────────────────── */

.discover-tabs {
    margin: 0 0 1 0;
    height: 3;
}

.discover-tabs Button {
    background: #111111;
    color: #666666;
    border: solid #333333;
    width: 1fr;
    height: 3;
}

.discover-tabs Button.-active,
.discover-tabs Button:hover {
    background: #0055ff;
    color: #ffffff;
}

/* ── Detail screens ─────────────────────────────────────────────── */

.detail-header {
    text-style: bold;
    color: #0055ff;
    margin: 0 0 1 0;
    width: 100%;
}

.detail-subheader {
    color: #666666;
    margin: 0 0 1 0;
    width: 100%;
}

.detail-card {
    background: #111111;
    border: solid #333333;
    padding: 1 2;
    margin: 1 0;
    width: 100%;
}

.detail-row {
    width: 100%;
    height: 1;
    margin: 0 0 0 0;
}

.detail-label {
    color: #666666;
}

.detail-value {
    color: #ffffff;
}

/* ── Score display ──────────────────────────────────────────────── */

.score-display {
    text-style: bold;
    color: #00cc66;
    text-align: center;
    width: 100%;
    height: 3;
    margin: 1 0;
}

/* ── Buttons (global) ───────────────────────────────────────────── */

Button {
    background: #111111;
    color: #ffffff;
    border: solid #333333;
}

Button:hover {
    background: #0055ff;
    color: #ffffff;
}

Button:focus {
    border: solid #0055ff;
}

.btn-primary {
    background: #0055ff !important;
    color: #ffffff !important;
}

.btn-success {
    background: #00cc66 !important;
    color: #000000 !important;
}

.btn-danger {
    background: #ff3333 !important;
    color: #ffffff !important;
}

/* ── Forms ──────────────────────────────────────────────────────── */

Input {
    background: #000000;
    border: solid #333333;
    color: #ffffff;
}

Input:focus {
    border: solid #0055ff;
}

Select {
    background: #000000;
    border: solid #333333;
    color: #ffffff;
}

Select:focus {
    border: solid #0055ff;
}

/* ── Scrollbar ──────────────────────────────────────────────── */

Scrollbar {
    background: #111111;
}

/* ── Generic utility classes ────────────────────────────────────── */

.text-blue { color: #0055ff; }
.text-green { color: #00cc66; }
.text-muted { color: #666666; }
.text-error { color: #ff3333; }
.text-bold { text-style: bold; }
.text-center { text-align: center; }
